# Desenvolvimento: npm run services gera .env.local privado automaticamente.
# Publicação: forneça valores próprios pelo gerenciador de segredos da hospedagem.
DATABASE_URL=
# Limite por instância; em serverless comece com 2 e acompanhe o total no provedor.
DATABASE_POOL_MAX=12
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DOCUMENT_KEY=
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Conecta SINTEDORP <nao-responda@example.test>"
ENABLE_DEMO=true
SITE_POLICY_STATUS=draft
# Preencher somente se o proxy confiável substituir este cabeçalho e bloquear acesso direto à origem.
TRUSTED_IP_HEADER=
