# Modelo sem credenciais. Salve os valores reais somente no painel da hospedagem
# ou em .local/production.env, com permissão 600, para checagens administrativas.
# Não use .env.local de desenvolvimento como configuração externa.
DATABASE_URL=
DATABASE_POOL_MAX=2
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DOCUMENT_KEY=
# Use smtps:// ou smtp:// com ?requireTLS=true; codifique usuário/senha na URL.
SMTP_URL=
MAIL_FROM=
ENABLE_DEMO=false
APP_MODE=live
# Somente após comprovar que o proxy substitui o cabeçalho.
TRUSTED_IP_HEADER=
# Registro operacional: não altera o texto da política exibido no site.
SITE_POLICY_STATUS=draft
